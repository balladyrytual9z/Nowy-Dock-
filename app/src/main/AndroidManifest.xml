<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Nawigacja offline: GPS nie jest wymagany do instalacji, ale urzadzenie go ma.
         Pozycje pobieramy z ACCESS_FINE_LOCATION (juz zadeklarowane wyzej). -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".DockApp"
        android:icon="@drawable/ic_launcher"
        android:label="Dock"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".LauncherActivity"
            android:label="Dock"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:configChanges="orientation|screenSize|keyboardHidden|density|uiMode|fontScale"
            android:theme="@android:style/Theme.Wallpaper.NoTitleBar.Fullscreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ConfigActivity"
            android:label="Dock - ustawienia"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <activity
            android:name=".NowPlayingActivity"
            android:label="Odtwarzane"
            android:launchMode="singleTop"
            android:exported="false" />

        <activity
            android:name=".MediaCenterActivity"
            android:label="Media Center"
            android:launchMode="singleTop"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />

        <activity
            android:name=".DockDiagnosticsActivity"
            android:label="Dock Diagnostyka"
            android:exported="false" />

        <activity
            android:name=".VoltDiagActivity"
            android:label="Diagnostyka zrodla napiecia"
            android:exported="false" />

        <activity
            android:name=".ConnectivityActivity"
            android:label="Lacznosc"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- Nawigacja offline (OpenStreetMap / osmdroid). Osobna ikona w launcherze
             systemowym (emblemat mapy) - uruchamia mapy bezposrednio. -->
        <activity
            android:name=".maps.NavigatorActivity"
            android:label="Mapy"
            android:icon="@drawable/ic_maps"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|keyboardHidden|density|uiMode|fontScale"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pobieranie map offline: całe regiony (np. Mazowsze) raz przy hotspotcie.
             Ekran uruchamiany z Ustawien -> Mapy (offline). -->
        <activity
            android:name=".maps.MapDownloadActivity"
            android:label="Pobierz mapy offline"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|keyboardHidden|density|uiMode|fontScale"
            android:exported="false" />

        <!-- Zakladki i slady (jak w Organic Maps): zapisane miejsca, import/eksport
             GPX/KML, slady jazdy i profil wysokosci. Ekran otwierany dlugim
             przytrzymaniem "Zap"/"Slad" w Nawigacji. -->
        <activity
            android:name=".maps.bookmark.BookmarksActivity"
            android:label="Zakladki"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|keyboardHidden|density|uiMode|fontScale"
            android:exported="false" />

        <activity
            android:name=".AppsActivity"
            android:label="Aplikacje"
            android:launchMode="singleTop"
            android:exported="false" />

        <activity
            android:name=".AllAppsActivity"
            android:label="Wszystkie aplikacje"
            android:launchMode="singleTop"
            android:exported="false" />

        <activity
            android:name=".AppsPickerActivity"
            android:label="Dock - aplikacje"
            android:exported="false" />

        <!-- DTC Manager (Mode 03/07 odczyt, Mode 04 kasowanie) -->
        <activity
            android:name=".diagnostics.DtcManagerActivity"
            android:label="DTC Manager"
            android:exported="false" />

        <!-- Misfire Lab: Mode 06, slupki cylinderow 1-4 -->
        <activity
            android:name=".diagnostics.MisfireLabActivity"
            android:label="Misfire Lab"
            android:exported="false" />

        <!-- Osobna ikona startowa: natychmiastowe kasowanie DTC bez potwierdzen -->
        <activity
            android:name=".diagnostics.KasujDtcActivity"
            android:label="Kasuj DTC"
            android:icon="@drawable/ic_bt"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- CarPlay Dashboard: dock + Overview + Live Data (Multi-Select) -->
        <activity
            android:name=".dashboard.CarPlayDashboardActivity"
            android:label="CarPlay Dashboard"
            android:launchMode="singleTop"
            android:exported="false" />

        <!-- Honda OEM UFO Cluster: pelne zegary 1280x720 -->
        <activity
            android:name=".ui.UfoClusterActivity"
            android:label="Honda UFO Cluster"
            android:launchMode="singleTop"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|density|uiMode" />

        <!-- Faza 5: Terminal AT/OBD (surowe komendy ELM327) -->
        <activity
            android:name=".terminal.ObdTerminalActivity"
            android:label="Terminal OBD"
            android:launchMode="singleTop"
            android:exported="false" />

        <!-- Faza 5: Ustawienia OBD (5 zakladek) -->
        <activity
            android:name=".settings.ObdSettingsActivity"
            android:label="Ustawienia OBD"
            android:launchMode="singleTop"
            android:exported="false" />

        <!-- Faza 5: E-RAPORT (raport stanu + DTC + share) -->
        <activity
            android:name=".report.EReportActivity"
            android:label="E-Raport"
            android:launchMode="singleTop"
            android:exported="false" />

        <!-- Faza 5: Black Box UI (przeglad + eksport CSV) -->
        <activity
            android:name=".blackbox.BlackBoxActivity"
            android:label="Black Box"
            android:launchMode="singleTop"
            android:exported="false" />

        <!-- Faza 5: Trip / Best Runs (0-100 km/h) -->
        <activity
            android:name=".trip.TripActivity"
            android:label="Trip i Best Runs"
            android:launchMode="singleTop"
            android:exported="false" />

        <!-- Faza 5: Maintenance (olej / filtr / rozrzad) -->
        <activity
            android:name=".maintenance.MaintenanceActivity"
            android:label="Serwis"
            android:launchMode="singleTop"
            android:exported="false" />

        <receiver
            android:name=".DockWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dock_widget_info" />
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".HeaderReceiver"
            android:exported="false" />

        <receiver
            android:name=".LaunchReceiver"
            android:exported="false" />

        <service
            android:name=".StatusService"
            android:exported="false" />

        <service
            android:name=".NightShiftService"
            android:exported="false" />

        <service
            android:name=".DockNotificationListener"
            android:label="Dock"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name=".DockStateProvider"
            android:authorities="pl.dock.widget.state"
            android:exported="true" />

        <!-- APK pobrany przez samoaktualizacje serwowany instalatorowi systemowemu -->
        <provider
            android:name=".ApkProvider"
            android:authorities="pl.dock.widget.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".ObdDiscoveryActivity"
            android:label="Honda OBD Discovery"
            android:launchMode="singleTop"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|density|uiMode" />

        <!-- Skanowanie adapterow OBD (Bluetooth Classic + BLE) -->
        <activity
            android:name=".ObdAdapterScanActivity"
            android:label="Skanowanie adapterow OBD"
            android:launchMode="singleTop"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|density|uiMode" />

        <service
            android:name=".ObdCoreService"
            android:exported="false" />

        <receiver
            android:name=".ObdWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/obd_widget_info" />
        </receiver>
    </application>
</manifest>
