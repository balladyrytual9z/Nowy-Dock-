
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- pogoda (Open-Meteo) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- jasnoÅÄ ekranu z centrum ÅÄcznoÅci (zgoda nadawana raz w ustawieniach Androida) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Night Shift (filtr barwy ekranu) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Sensor Fusion: UsageStats for CarPlayHostActivity detection -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:icon="@drawable/ic_launcher"
        android:label="Dock"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Launcher (ekran gÅÃ³wny) -->
        <activity
            android:name=".LauncherActivity"
            android:label="Dock"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:configChanges="orientation|screenSize|keyboardHidden|density|uiMode|fontScale"
            android:theme="@android:style/Theme.Wallpaper.NoTitleBar.Fullscreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ConfigActivity"
            android:label="Dock â ustawienia"
            android:exported="true">
            <!-- Ustawienia otwierane z docka / siatki, nie jako ikona startowa -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <activity
            android:name=".NowPlayingActivity"
            android:label="Odtwarzane"
            android:launchMode="singleTop"
            android:exported="false" />

        <activity
            android:name=".MediaCenterActivity"
            android:label="Media Center"
            android:launchMode="singleTop"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />

        <activity
            android:name=".DockDiagnosticsActivity"
            android:label="Dock Diagnostyka"
            android:exported="false" />

        <activity
            android:name=".VoltDiagActivity"
            android:label="Diagnostyka ÅºrÃ³dÅa napiÄcia"
            android:exported="false" />

        <activity
            android:name=".ConnectivityActivity"
            android:label="ÅÄcznoÅÄ"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name=".AppsActivity"
            android:label="Aplikacje"
            android:launchMode="singleTop"
            android:exported="false" />

        <activity
            android:name=".AppsPickerActivity"
            android:label="Dock â aplikacje"
            android:exported="false" />

        <receiver
            android:name=".DockWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dock_widget_info" />
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".HeaderReceiver"
            android:exported="false" />

        <receiver
            android:name=".LaunchReceiver"
            android:exported="false" />

        <service
            android:name=".StatusService"
            android:exported="false" />

        <service
            android:name=".NightShiftService"
            android:exported="false" />

        <!-- DostÄp do sesji multimedialnych (DiPlay) i powiadomieÅ â wÅÄczany rÄcznie przez uÅ¼ytkownika -->
        <service
            android:name=".DockNotificationListener"
            android:label="Dock"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <provider
            android:name=".DockStateProvider"
            android:authorities="pl.dock.widget.state"
            android:exported="true" />

        <!-- Circadian Display â Dock night-mode bridge -->
        <receiver
            android:name=".circadian.NightModeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="pl.circadiandisplay.STATE_CHANGED" />
                <action android:name="pl.dock.widget.NIGHT_MODE_CHANGED" />
            </intent-filter>
        </receiver>


        <activity
            android:name=".ObdDiscoveryActivity"
            android:label="Honda OBD Discovery"
            android:launchMode="singleTop"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|density|uiMode" />

        <!-- OBD core: czarna skrzynka (WAL), analityka, alerty audio, NanoServer -->
        <service
            android:name=".ObdCoreService"
            android:exported="false" />

        <!-- OBD widget (25dp, stale-data aware) -->
        <receiver
            android:name=".ObdWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/obd_widget_info" />
        </receiver>
    </application>
</manifest>







